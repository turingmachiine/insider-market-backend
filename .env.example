# Application Settings
APP_NAME="Football Research API"
APP_VERSION="1.0.0"
DEBUG=true
ENVIRONMENT="development"

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=football_db

# External APIs
FBREF_BASE_URL=https://fbref.com
TRANSFERMARKT_BASE_URL=https://transfermarkt.com
UNDERSTAT_BASE_URL=https://understat.com

# API Keys (optional)
RAPIDAPI_KEY=
FOOTBALL_DATA_API_KEY=

# Logging
LOG_LEVEL=INFO
JSON_LOGS=false

# Cache
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600

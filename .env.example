# Application Settings
APP_NAME="Football Research Insider Market"
APP_VERSION="1.0.0"
DEBUG=true
ENVIRONMENT="development"

# Server
HOST=0.0.0.0
PORT=8000
AUTH_PORT=8001
RUMOR_PORT=8003
GATEWAY_PORT=8000
WORKERS=1

# NSI Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT_NSI=5432
POSTGRES_DB_NSI=football_db
DATABASE_URL_NSI=postgresql+asyncpg://postgres:postgres@localhost:5432/football_db

# Auth Database
POSTGRES_USER_AUTH=postgres
POSTGRES_PASSWORD_AUTH=postgres
POSTGRES_HOST_AUTH=localhost
POSTGRES_PORT_AUTH=5433
POSTGRES_DB_AUTH=auth_db
DATABASE_URL_AUTH=postgresql+asyncpg://postgres:postgres@localhost:5433/auth_db

# Rumor Database
POSTGRES_USER_RUMOR=postgres
POSTGRES_PASSWORD_RUMOR=postgres
POSTGRES_HOST_RUMOR=localhost
POSTGRES_PORT_RUMOR=5434
POSTGRES_DB_RUMOR=rumor_db
DATABASE_URL_RUMOR=postgresql+asyncpg://postgres:postgres@localhost:5434/rumor_db

# JWT
JWT_SECRET=change-me
JWT_TTL=3600

# External APIs
FBREF_BASE_URL=https://fbref.com
TRANSFERMARKT_BASE_URL=https://transfermarkt.com
UNDERSTAT_BASE_URL=https://understat.com

# API Keys (optional)
RAPIDAPI_KEY=
FOOTBALL_DATA_API_KEY=

# Logging
LOG_LEVEL=INFO
JSON_LOGS=false

# Cache
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600
PERMISSIONS_CACHE_TTL=300

# API Gateway
SERVICE_NSI_URL=http://nsi_service:8001
SERVICE_AUTH_URL=http://auth_service:8002
SERVICE_RUMOR_URL=http://rumor_service:8003
GATEWAY_REDIS_URL=redis://redis:6379/0
RATE_LIMIT=100/minute
RATE_LIMIT_BY_JWT=true
CACHE_TTL_SECONDS=30
CORS_ORIGINS=["http://localhost:3000"]
MAX_BODY_SIZE_MB=10

# Application
APP_NAME="Football Research Insider Market"
APP_VERSION="1.0.0"
DEBUG=true
ENVIRONMENT=development
HOST=0.0.0.0

# Generic server settings for direct local service runs
PORT=8000
AUTH_PORT=8001
RUMOR_PORT=8003
EVENT_PORT=8004
MARKET_PORT=8005
PROFILE_PORT=8007
RATING_PORT=8008
ADMIN_PORT=8009
GATEWAY_PORT=8000
WORKERS=1
GATEWAY_WORKERS=2

# Service-local names.
# Do not set these in a shared compose .env unless running a single service directly.
# PROXY_NAME=nsi
# SERVICE_NAME=rating_service

# NSI database for direct runs
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=football_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/football_db
DATABASE_URL_NSI=postgresql+asyncpg://postgres:postgres@postgres_nsi:5432/football_db

# NSI database container
POSTGRES_USER_NSI=postgres
POSTGRES_PASSWORD_NSI=postgres
POSTGRES_PORT_NSI=5432
POSTGRES_DB_NSI=football_db

# Auth database
POSTGRES_USER_AUTH=postgres
POSTGRES_PASSWORD_AUTH=postgres
POSTGRES_HOST_AUTH=localhost
POSTGRES_PORT_AUTH=5433
POSTGRES_DB_AUTH=auth_db
DATABASE_URL_AUTH=postgresql+asyncpg://postgres:postgres@postgres_auth:5432/auth_db

# Admin database
POSTGRES_USER_ADMIN=postgres
POSTGRES_PASSWORD_ADMIN=postgres
POSTGRES_HOST_ADMIN=localhost
POSTGRES_PORT_ADMIN=5439
POSTGRES_DB_ADMIN=admin_db
DATABASE_URL_ADMIN=postgresql+asyncpg://postgres:postgres@postgres_admin:5432/admin_db

# Rumor database
POSTGRES_USER_RUMOR=postgres
POSTGRES_PASSWORD_RUMOR=postgres
POSTGRES_HOST_RUMOR=localhost
POSTGRES_PORT_RUMOR=5434
POSTGRES_DB_RUMOR=rumor_db
DATABASE_URL_RUMOR=postgresql+asyncpg://postgres:postgres@postgres_rumor:5432/rumor_db

# Event database
POSTGRES_USER_EVENT=postgres
POSTGRES_PASSWORD_EVENT=postgres
POSTGRES_HOST_EVENT=localhost
POSTGRES_PORT_EVENT=5435
POSTGRES_DB_EVENT=event_db
DATABASE_URL_EVENT=postgresql+asyncpg://postgres:postgres@postgres_event:5432/event_db

# Market database
POSTGRES_USER_MARKET=postgres
POSTGRES_PASSWORD_MARKET=postgres
POSTGRES_HOST_MARKET=localhost
POSTGRES_PORT_MARKET=5436
POSTGRES_DB_MARKET=market_db
DATABASE_URL_MARKET=postgresql+asyncpg://postgres:postgres@postgres_market:5432/market_db

# Profile database
POSTGRES_USER_PROFILE=postgres
POSTGRES_PASSWORD_PROFILE=postgres
POSTGRES_HOST_PROFILE=localhost
POSTGRES_PORT_PROFILE=5437
POSTGRES_DB_PROFILE=profile_db
DATABASE_URL_PROFILE=postgresql+asyncpg://postgres:postgres@postgres_profile:5432/profile_db

# Rating database
POSTGRES_USER_RATING=postgres
POSTGRES_PASSWORD_RATING=postgres
POSTGRES_HOST_RATING=localhost
POSTGRES_PORT_RATING=5438
POSTGRES_DB_RATING=rating_db
DATABASE_URL_RATING=postgresql+asyncpg://postgres:postgres@postgres_rating:5432/rating_db

# Redis and cache
REDIS_URL=redis://redis:6379/0
GATEWAY_REDIS_URL=redis://redis:6379/0
CACHE_TTL=3600
CACHE_TTL_SECONDS=30
PERMISSIONS_CACHE_TTL=300

# JWT and password security
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_TTL=3600
REFRESH_TOKEN_TTL=2592000
PASSWORD_RESET_TOKEN_TTL=3600
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# Service-to-service auth
SERVICE_JWT_SECRET=change-me-service
SERVICE_JWT_ALGORITHM=HS256
SERVICE_JWT_TTL=300

# API Gateway upstream services
SERVICE_NSI_URL=http://nsi_service:8001
SERVICE_AUTH_URL=http://auth_service:8002
SERVICE_RUMOR_URL=http://rumor_service:8003
SERVICE_EVENT_URL=http://event_service:8004
SERVICE_MARKET_URL=http://market_service:8005
SERVICE_NOTIFICATION_URL=http://notification_service:8006
SERVICE_PROFILE_URL=http://profile_service:8007
SERVICE_RATING_URL=http://rating_service:8008
SERVICE_ADMIN_URL=http://admin_service:8009

# API Gateway rate limits
RATE_LIMIT=100/minute
PUBLIC_RATE_LIMIT=100/minute
SENSITIVE_RATE_LIMIT=10/minute
WEBSOCKET_RATE_LIMIT=20/minute
RATE_LIMIT_BY_JWT=true

# API Gateway CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
CORS_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
CORS_HEADERS=["Authorization","Content-Type","X-Request-ID","X-Service-Authorization"]
CORS_EXPOSE_HEADERS=["X-Request-ID","Retry-After"]
CORS_ALLOW_CREDENTIALS=true

# API Gateway hardening and timeouts
MAX_BODY_SIZE_MB=10
HSTS_MAX_AGE_SECONDS=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false
CONTENT_SECURITY_POLICY="default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data:; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; connect-src 'self'"
X_FRAME_OPTIONS=DENY
REFERRER_POLICY=no-referrer
PERMISSIONS_POLICY="camera=(), microphone=(), geolocation=(), payment=(), usb=()"
SERVICE_TIMEOUT_SECONDS=5
TOTAL_TIMEOUT_SECONDS=10
STATS_TTL_SECONDS=300

# Admin service
ADMIN_CLIENT_TIMEOUT_SECONDS=10
DASHBOARD_PREVIEW_LIMIT=10

# Notification service
NOTIFICATION_CHANNEL_PREFIX=notifications
SSE_KEEPALIVE_SECONDS=15

# Rating service and workers
PROFILE_SERVICE_URL=http://profile_service:8007
REWARD_REQUEST_TIMEOUT_SECONDS=5
TASKIQ_REDIS_URL=redis://redis:6379/0
TASKIQ_QUEUE_NAME=insider_market_backend_etl
RATING_TASKIQ_QUEUE_NAME=insider_market_backend_rating
ETL_TASKIQ_JOBS_CONFIG_PATH=/app/resources/etl_service/taskiq/jobs.yml
RATING_TASKIQ_JOBS_CONFIG_PATH=/app/resources/rating_service/taskiq/jobs.yml
BACKGROUND_BATCH_SIZE=250
RATING_BACKGROUND_BATCH_SIZE=250

# ETL service and workers
RUMOR_SERVICE_URL=http://rumor_service:8003
REQUEST_TIMEOUT_SECONDS=20
SOURCE_FETCH_LIMIT=20
RAW_PUBLICATIONS_LIMIT=500
EXISTING_RUMORS_LIMIT=500

# External football data providers
FBREF_BASE_URL=https://fbref.com
TRANSFERMARKT_BASE_URL=https://transfermarkt.com
UNDERSTAT_BASE_URL=https://understat.com
RAPIDAPI_KEY=
FOOTBALL_DATA_API_KEY=

# Logging
LOG_LEVEL=INFO
JSON_LOGS=true
LOG_BROKER_ENABLED=true
LOG_REDIS_URL=redis://redis:6379/0
LOG_REDIS_KEY=logs:football

# Local tooling and infrastructure ports
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
REDIS_COMMANDER_PORT=8081
